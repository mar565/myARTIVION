{
  "name": "myartivion-pwa",
  "version": "1.0.0",
  "description": "MyARTIVION Mitarbeiter-App - Progressive Web Application",
  "scripts": {
    "build": "node generate-pwa-icons.js && mkdir -p build && cp -r *.html css js images icons manifest.json service-worker.js build/ 2>/dev/null || echo 'Files ready in root'",
    "build:azure": "npm run build",
    "generate-icons": "node generate-pwa-icons.js",
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "postinstall": "npm run generate-icons"
  },
  "keywords": [
    "pwa",
    "employee-app",
    "myartivion"
  ],
  "author": "Artivion, Inc.",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
